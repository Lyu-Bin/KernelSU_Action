# KernelSU Action -- 构建配置文件
#
# 此处的值为默认值；workflow_dispatch 输入会在每次运行时覆盖它们。
# 只有精确的字符串 "true"（或 yes/on/1）才会被视为启用。
#
# 将此文件复制到 config/<device>.env 以为每台设备保留一个配置文件，然后
# 在启动构建时通过 "Config file to build" 输入选择它。

CONFIG_ENV=config.env

# ============================================================ 内核源码 ==

KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_xiaomi_earth
KERNEL_SOURCE_BRANCH=lineage-23.2
KERNEL_CONFIG=earth_defconfig
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64

# 可选：覆盖产物名称中使用的设备标签，并设置
# CONFIG_LOCALVERSION。留空则从 KERNEL_CONFIG 推导。
KERNEL_NAME=

ADD_LOCALVERSION_TO_FILENAME=false

# 追加到每次 make 调用的额外标志。值可以包含 "="。
# 这个 4.19 内核树在厂商驱动中仍有 K&R 风格的空参数列表。
# 保留该诊断信息可见，但在现代 Clang 下不要让它成为致命错误。
EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
#
# AOSP 按 "kernel-build" 分支发布预编译 clang，但每个分支实际上
# 只包含一两个工具链——其他版本目录是空占位符，下载后仍是有效的
# （空）归档。截至 2026-09 验证可用的配对：
#
#   CLANG_BRANCH=main-kernel               CLANG_VERSION=r614150   (最新)
#   CLANG_BRANCH=main-kernel-2026          CLANG_VERSION=r584948c
#   CLANG_BRANCH=main-kernel-2025          CLANG_VERSION=r547379
#   CLANG_BRANCH=main-kernel-build-2024    CLANG_VERSION=r510928
#   CLANG_BRANCH=master-kernel-build-2022  CLANG_VERSION=r450784e
#
# 较新的 clang 在 4.x 内核树上经常失败（移除了标志、更严格的警告）。
# r450784e 是 4.9-4.19 的安全选择；5.10+ 请使用 r547379 或更新版本。
CLANG_BRANCH=main-kernel-2025
CLANG_VERSION=r547379

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# 完全使用 LLVM 构建（LLVM=1 LLVM_IAS=1）。适合 5.10+，在 4.x 上通常会失败。
USE_LLVM=false

# ===================================================================== GCC ==
#
# 仅作为无法使用 LLVM 集成汇编器的旧内核树的 binutils 使用。
# 当 USE_LLVM=true 时，两者都应关闭。
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===
#
# KSU_VARIANT 选择要集成哪个分支：
#
#   none           无 root 方案，纯内核构建
#   kernelsu       tiann/KernelSU，原始版本。在 v1.0 中放弃了对非 GKI 的支持，
#                  因此早于 5.10 的内核被固定到 v0.9.5。
#   kernelsu-next  KernelSU-Next。分支：dev（默认）、stable、legacy。
#                  旧内核需要 KSU_REF=legacy。
#   sukisu-ultra   SukiSU-Ultra。main = 模块化 v4 树，支持 KPM；
#                  builtin = 源码集成树，也是唯一自带 SUSFS 的 ref。
#   resukisu       ReSukiSU，SukiSU-Ultra 的再分支，专注于旧版和
#                  非 GKI 内核，支持多管理器。
#   rsuntk         rsuntk/KernelSU（RKSU）。
#   backslashxx    backslashxx/KernelSU，面向手动 hook。
#
# KSU_REF 是分支、标签或提交。留空则让 action 为你的内核版本
# 选择合适的 ref。使用前会进行验证：未知 ref 会使构建失败，
# 而不是静默回退，这正是上游 setup.sh 脚本自身的行为。
#
# KernelSU-Next 在旧内核上使用 legacy 分支。
KSU_VARIANT=kernelsu-next
KSU_REF=legacy

# auto | kprobes | manual | tracepoint | syscall | none
# "auto" 在 5.10+ 上使用 kprobes，在旧内核上使用手动 hook，
# 在旧内核上 kprobes 通常是 KernelSU 安装后 su 无效的原因。
KSU_HOOK_MODE=manual

# 自定义管理器 APK 签名。留空则使用官方管理器。
# 使用以下命令获取：ksud debug get-sign <apk_path>
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
#
# SUSFS 对 root 检测隐藏挂载、路径和 kstat。当留为 "auto" 时，
# 分支会根据你的内核版本推导。
#
# 注意：susfs4ksu 的非 GKI 分支（kernel-4.9/4.14/4.19/5.4）自 2025 年初
# 以来未更新，仍针对 KernelSU 旧的扁平源码布局。此后重构过的分支
# 可能无法应用 KernelSU 侧的补丁。KSU_VARIANT=sukisu-ultra 配合
# KSU_REF=builtin 可避免此问题，因为它自带 SUSFS 支持。
#
# KernelSU-Next 不内置 SUSFS，需从 susfs4ksu 拉取补丁，4.19 补丁
# 已停更且冲突概率高。先关闭 SUSFS 验证 Root 是否能正常编译和运行，
# SUSFS 后续再单独处理。
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== 额外补丁 ===

# path_umount() 在 Linux 5.9 中引入。KernelSU 用它在其自身的
# overlay 上卸载，以便在 root 检查运行前完成，因此旧内核需要
# 将其移植回来。在 5.9+ 上会被忽略（并给出提示）。
ENABLE_PATH_UMOUNT=true

# 在 SUSFS 之上额外进行指纹移除。
ENABLE_HIDE_STUFF=false

# SukiSU-Ultra 的 Kernel Patch Module 支持。仅 arm64。
ENABLE_KPM=false

# ================================================================ Kconfig ===

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=true
DISABLE_CC_WERROR=true

# 自由形式的 defconfig 行，以空格或换行分隔。
EXTRA_DEFCONFIG=CONFIG_KALLSYMS=y CONFIG_KALLSYMS_ALL=y

# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== 打包 ===

NEED_DTBO=false

# 围绕新内核重新打包 boot.img。SOURCE_BOOT_IMAGE 必须是指向
# 同一设备和 ROM 的可启动镜像的直接链接。
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= 运行器 ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
